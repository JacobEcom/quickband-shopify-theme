{% doc %}
  @prompt
    I would like to create a block that utilizes a full-screen hero image as the background. On top of that hero, I would like to create a shopping tile that allows me to have a headline, sub headline, body, and 6 bullets worth of text. I would like to be able to add custom icons as the bullet points. 
    
    , can I have it so i can select the dimensions of the hero image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-shopping-tile-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.hero_height_type == 'custom' %}
      height: {{ block.settings.hero_height_desktop }}px;
    {% else %}
      min-height: 100vh;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-hero-shopping-tile__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-shopping-tile__background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-shopping-tile__background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-shopping-tile__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 800px;
    max-height: 600px;
  }

  .ai-hero-shopping-tile__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 2;
  }

  .ai-hero-shopping-tile__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: {{ block.settings.tile_width }}%;
    max-width: 100%;
    padding: {{ block.settings.tile_padding }}px;
    background-color: {{ block.settings.tile_background_color }};
    border-radius: {{ block.settings.tile_border_radius }}px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, {{ block.settings.tile_shadow_opacity }});
    margin: 40px 20px;
  }

  .ai-hero-shopping-tile__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.2;
  }

  .ai-hero-shopping-tile__subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    color: {{ block.settings.subheadline_color }};
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.4;
  }

  .ai-hero-shopping-tile__body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.6;
  }

  .ai-hero-shopping-tile__bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-hero-shopping-tile__bullet-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.bullet_icon_spacing }}px;
    margin-bottom: {{ block.settings.bullet_spacing }}px;
  }

  .ai-hero-shopping-tile__bullet-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-hero-shopping-tile__bullet-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.bullet_icon_size }}px;
    height: {{ block.settings.bullet_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-hero-shopping-tile__bullet-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-hero-shopping-tile__bullet-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.bullet_icon_placeholder_color }};
    border-radius: 50%;
  }

  .ai-hero-shopping-tile__bullet-text-{{ ai_gen_id }} {
    flex: 1;
    font-size: {{ block.settings.bullet_text_size }}px;
    color: {{ block.settings.bullet_text_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-shopping-tile-{{ ai_gen_id }} {
      {% if block.settings.hero_height_type == 'custom' %}
        height: {{ block.settings.hero_height_mobile }}px;
      {% else %}
        min-height: 100vh;
      {% endif %}
    }

    .ai-hero-shopping-tile__content-{{ ai_gen_id }} {
      width: 90%;
      padding: {{ block.settings.tile_padding | times: 0.7 }}px;
    }

    .ai-hero-shopping-tile__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-hero-shopping-tile__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.8 }}px;
    }

    .ai-hero-shopping-tile__body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }

    .ai-hero-shopping-tile__bullet-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.bullet_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-shopping-tile-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-shopping-tile__background-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2400 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
      >
    {% else %}
      <div class="ai-hero-shopping-tile__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-shopping-tile__overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-shopping-tile__content-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h1 class="ai-hero-shopping-tile__headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h1>
    {% endif %}

    {% if block.settings.subheadline != blank %}
      <h2 class="ai-hero-shopping-tile__subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</h2>
    {% endif %}

    {% if block.settings.body != blank %}
      <div class="ai-hero-shopping-tile__body-{{ ai_gen_id }}">{{ block.settings.body }}</div>
    {% endif %}

    <ul class="ai-hero-shopping-tile__bullets-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign bullet_text_key = 'bullet_' | append: i | append: '_text'
          assign bullet_icon_key = 'bullet_' | append: i | append: '_icon'
          assign bullet_text = block.settings[bullet_text_key]
          assign bullet_icon = block.settings[bullet_icon_key]
        %}

        {% if bullet_text != blank %}
          <li class="ai-hero-shopping-tile__bullet-{{ ai_gen_id }}">
            <div class="ai-hero-shopping-tile__bullet-icon-{{ ai_gen_id }}">
              {% if bullet_icon %}
                <img
                  src="{{ bullet_icon | image_url: width: 100 }}"
                  alt=""
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% else %}
                <div class="ai-hero-shopping-tile__bullet-icon-placeholder-{{ ai_gen_id }}"></div>
              {% endif %}
            </div>
            <div class="ai-hero-shopping-tile__bullet-text-{{ ai_gen_id }}">{{ bullet_text }}</div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

