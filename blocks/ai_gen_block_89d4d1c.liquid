{% doc %}
  @prompt
    I want to create a variant picker that displays the name of the product variation, as well as the price and the strike-through pricing, Please include an option to select my products so it includes my variants
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if block.settings.product != blank %}
  {% assign selected_product = block.settings.product %}
{% else %}
  {% assign selected_product = product %}
{% endif %}

{% style %}
  .ai-variant-picker-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-variant-picker__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-variant-picker__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin-bottom: 8px;
  }

  .ai-variant-picker__options-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.option_spacing }}px;
  }

  .ai-variant-picker__option-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.option_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ai-variant-picker__option-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.selected {
    background-color: {{ block.settings.selected_background_color }};
    border-color: {{ block.settings.selected_border_color }};
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.selected:hover {
    background-color: {{ block.settings.selected_hover_background_color }};
    border-color: {{ block.settings.selected_hover_border_color }};
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.unavailable {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-variant-picker__radio-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ai-variant-picker__option-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .ai-variant-picker__radio-visual-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    border: 2px solid {{ block.settings.border_color }};
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.selected .ai-variant-picker__radio-visual-{{ ai_gen_id }} {
    border-color: {{ block.settings.selected_border_color }};
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.selected .ai-variant-picker__radio-visual-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    background-color: {{ block.settings.selected_border_color }};
    border-radius: 50%;
  }

  .ai-variant-picker__variant-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.variant_name_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.selected .ai-variant-picker__variant-name-{{ ai_gen_id }} {
    color: {{ block.settings.selected_text_color }};
  }

  .ai-variant-picker__price-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-variant-picker__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.selected .ai-variant-picker__price-{{ ai_gen_id }} {
    color: {{ block.settings.selected_text_color }};
  }

  .ai-variant-picker__compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-variant-picker__option-{{ ai_gen_id }}.selected .ai-variant-picker__compare-price-{{ ai_gen_id }} {
    color: {{ block.settings.selected_text_color }};
    opacity: 0.7;
  }

  .ai-variant-picker__empty-state-{{ ai_gen_id }} {
    padding: {{ block.settings.option_padding }}px;
    text-align: center;
    color: #999999;
    font-style: italic;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-variant-picker-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<variant-picker-{{ ai_gen_id }}
  class="ai-variant-picker-{{ ai_gen_id }}"
  data-product-id="{% if selected_product %}{{ selected_product.id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="ai-variant-picker__container-{{ ai_gen_id }}">
    {% if block.settings.show_label %}
      <div class="ai-variant-picker__label-{{ ai_gen_id }}">
        {{ block.settings.label_text }}
      </div>
    {% endif %}

    <div class="ai-variant-picker__options-{{ ai_gen_id }}">
      {% if selected_product and selected_product.variants.size > 0 %}
        {% for variant in selected_product.variants %}
          <label
            class="ai-variant-picker__option-{{ ai_gen_id }} {% if variant.id == selected_product.selected_or_first_available_variant.id %}selected{% endif %} {% unless variant.available %}unavailable{% endunless %}"
            data-variant-id="{{ variant.id }}"
          >
            <input
              type="radio"
              name="variant-{{ ai_gen_id }}"
              value="{{ variant.id }}"
              class="ai-variant-picker__radio-{{ ai_gen_id }}"
              {% if variant.id == selected_product.selected_or_first_available_variant.id %}checked{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
            
            <div class="ai-variant-picker__option-content-{{ ai_gen_id }}">
              <div class="ai-variant-picker__radio-visual-{{ ai_gen_id }}"></div>
              
              <div class="ai-variant-picker__variant-name-{{ ai_gen_id }}">
                {{ variant.title }}
                {% unless variant.available %}
                  <span>(Sold out)</span>
                {% endunless %}
              </div>
            </div>

            <div class="ai-variant-picker__price-container-{{ ai_gen_id }}">
              {% if variant.compare_at_price > variant.price %}
                <span class="ai-variant-picker__compare-price-{{ ai_gen_id }}">
                  {{ variant.compare_at_price | money }}
                </span>
              {% endif %}
              
              <span class="ai-variant-picker__price-{{ ai_gen_id }}">
                {{ variant.price | money }}
              </span>
            </div>
          </label>
        {% endfor %}
      {% else %}
        <div class="ai-variant-picker__empty-state-{{ ai_gen_id }}">
          {% if block.settings.product == blank %}
            Select a product to display variants
          {% else %}
            No variants available for this product
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</variant-picker-{{ ai_gen_id }}>

<script>
  (function() {
    class VariantPicker{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productId = this.dataset.productId;
      }

      connectedCallback() {
        this.options = this.querySelectorAll('.ai-variant-picker__option-{{ ai_gen_id }}');
        this.radios = this.querySelectorAll('.ai-variant-picker__radio-{{ ai_gen_id }}');

        this.setupEventListeners();

        const checkedRadio = this.querySelector('.ai-variant-picker__radio-{{ ai_gen_id }}:checked');
        if (checkedRadio) {
          this.updateProductForm(checkedRadio.value);
        }
      }

      setupEventListeners() {
        // Click support
        this.options.forEach((option) => {
          option.addEventListener('click', (e) => {
            if (option.classList.contains('unavailable')) {
              e.preventDefault();
              return;
            }

            const radio = option.querySelector('.ai-variant-picker__radio-{{ ai_gen_id }}');
            if (radio && !radio.disabled) {
              radio.checked = true;
              radio.dispatchEvent(new Event('change')); // trigger change logic
            }
          });
        });

        // Change support (IMPORTANT)
        this.radios.forEach((radio) => {
          radio.addEventListener('change', () => {
            const option = radio.closest('.ai-variant-picker__option-{{ ai_gen_id }}');
            if (!option) return;

            this.options.forEach(opt => opt.classList.remove('selected'));
            option.classList.add('selected');

            const variantId = radio.value;

            this.updateProductForm(variantId);
            this.updateURL(variantId);
            this.dispatchVariantChange(variantId);
          });
        });
      }

      updateProductForm(variantId) {
        const productForms = document.querySelectorAll('form[action*="/cart/add"]');

        productForms.forEach((form) => {
          let variantInput = form.querySelector('input[name="id"]');

          if (!variantInput) {
            variantInput = document.createElement('input');
            variantInput.type = 'hidden';
            variantInput.name = 'id';
            form.appendChild(variantInput);
          }

          variantInput.value = variantId;
        });
      }

      updateURL(variantId) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);
        window.history.replaceState({}, '', url);
      }

      dispatchVariantChange(variantId) {
        const event = new CustomEvent('variant:change', {
          detail: { variantId: variantId },
          bubbles: true
        });
        this.dispatchEvent(event);
      }
    }

    if (!customElements.get('variant-picker-{{ ai_gen_id }}')) {
      customElements.define('variant-picker-{{ ai_gen_id }}', VariantPicker{{ ai_gen_id }});
    }
  })();
</script>

