{% doc %}
  @prompt
    I would like to create a block that utilizes a full-screen hero image as the background. Can I have it so i can select the dimensions of the hero image.
    
    On top of that hero, I would like to create a shopping tile that allows me to have a headline, sub headline, body, and 6 bullets worth of text. I would like to be able to add custom icons as the bullet points. 
    
    I would like to be able to place this shopping tile on the left, right or center of the hero image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-shopping-tile-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.hero_height }}vh;
    overflow: hidden;
    display: block;
  }

  .ai-hero-shopping-tile__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-shopping-tile__background-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-shopping-tile__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-shopping-tile__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-shopping-tile__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 40px;
    {% if block.settings.tile_position == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.tile_position == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: center;
    {% endif %}
  }

  .ai-hero-shopping-tile__tile-{{ ai_gen_id }} {
    background-color: {{ block.settings.tile_background_color }};
    padding: {{ block.settings.tile_padding }}px;
    border-radius: {{ block.settings.tile_border_radius }}px;
    max-width: {{ block.settings.tile_max_width }}px;
    width: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .ai-hero-shopping-tile__headline-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_size }}px;
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.2;
  }

  .ai-hero-shopping-tile__subheadline-{{ ai_gen_id }} {
    color: {{ block.settings.subheadline_color }};
    font-size: {{ block.settings.subheadline_size }}px;
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.4;
  }

  .ai-hero-shopping-tile__body-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.6;
  }

  .ai-hero-shopping-tile__bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-hero-shopping-tile__bullet-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: {{ block.settings.bullet_spacing }}px;
    color: {{ block.settings.bullet_text_color }};
    font-size: {{ block.settings.bullet_text_size }}px;
    line-height: 1.5;
  }

  .ai-hero-shopping-tile__bullet-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-hero-shopping-tile__bullet-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.bullet_icon_size }}px;
    height: {{ block.settings.bullet_icon_size }}px;
    object-fit: contain;
  }

  .ai-hero-shopping-tile__bullet-icon-placeholder-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.bullet_icon_size }}px;
    height: {{ block.settings.bullet_icon_size }}px;
    background-color: {{ block.settings.bullet_text_color }};
    border-radius: 50%;
  }

  .ai-hero-shopping-tile__bullet-text-{{ ai_gen_id }} {
    flex: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-shopping-tile__container-{{ ai_gen_id }} {
      padding: 20px;
      justify-content: center;
    }

    .ai-hero-shopping-tile__tile-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-hero-shopping-tile__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-hero-shopping-tile__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.8 }}px;
    }

    .ai-hero-shopping-tile__body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<hero-shopping-tile-{{ ai_gen_id }}
  class="ai-hero-shopping-tile-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.hero_image %}
    <img
      src="{{ block.settings.hero_image | image_url: width: 2400 }}"
      alt="{{ block.settings.hero_image.alt | escape }}"
      loading="lazy"
      width="{{ block.settings.hero_image.width }}"
      height="{{ block.settings.hero_image.height }}"
      class="ai-hero-shopping-tile__background-{{ ai_gen_id }}"
    >
  {% else %}
    <div class="ai-hero-shopping-tile__background-placeholder-{{ ai_gen_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
      <div class="ai-hero-shopping-tile__empty-state-{{ ai_gen_id }}">
        Add a hero image to get started
      </div>
    </div>
  {% endif %}

  <div class="ai-hero-shopping-tile__container-{{ ai_gen_id }}">
    <div class="ai-hero-shopping-tile__tile-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-hero-shopping-tile__headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.subheadline != blank %}
        <h3 class="ai-hero-shopping-tile__subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</h3>
      {% endif %}

      {% if block.settings.body != blank %}
        <div class="ai-hero-shopping-tile__body-{{ ai_gen_id }}">{{ block.settings.body }}</div>
      {% endif %}

      <ul class="ai-hero-shopping-tile__bullets-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign bullet_text_key = 'bullet_' | append: i | append: '_text'
            assign bullet_icon_key = 'bullet_' | append: i | append: '_icon'
            assign bullet_text = block.settings[bullet_text_key]
            assign bullet_icon = block.settings[bullet_icon_key]
          %}

          {% if bullet_text != blank %}
            <li class="ai-hero-shopping-tile__bullet-item-{{ ai_gen_id }}">
              {% if bullet_icon %}
                <img
                  src="{{ bullet_icon | image_url: width: 100 }}"
                  alt=""
                  class="ai-hero-shopping-tile__bullet-icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% else %}
                <span class="ai-hero-shopping-tile__bullet-icon-placeholder-{{ ai_gen_id }}"></span>
              {% endif %}
              <span class="ai-hero-shopping-tile__bullet-text-{{ ai_gen_id }}">{{ bullet_text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</hero-shopping-tile-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroShoppingTile{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('hero-shopping-tile-{{ ai_gen_id }}', HeroShoppingTile{{ ai_gen_id }});
  })();
</script>

