    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Icon hover color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Cart badge"
    },
    {
      "type": "color",
      "id": "cart_badge_color",
      "label": "Background color",
      "default": "#c15045"
    },
    {
      "type": "color",
      "id": "cart_badge_text_color",
