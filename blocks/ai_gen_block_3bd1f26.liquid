      "type": "range",
      "id": "mobile_icon_spacing",
      "label": "Mobile icon spacing",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "icon_color",
